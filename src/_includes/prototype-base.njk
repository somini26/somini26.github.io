<!doctype html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="robots" content="noindex, nofollow">
  <title>{{ title }} · somani design prototype</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <script src="/assets/prototype-theme.js"></script>
  <link rel="stylesheet" href="/assets/prototypes.css">
  {% if 'prototype-c' in prototypeClass %}<link rel="stylesheet" href="/assets/prototype-c.css">{% endif %}
  <script src="/assets/prototypes.js" defer></script>
  {% if 'prototype-c' in prototypeClass %}<script src="/assets/prototype-c.js" defer></script>{% endif %}
</head>
<body class="prototype-page {{ prototypeClass }}">
  <a class="prototype-skip" href="#prototype-main">본문으로 건너뛰기</a>
  <header class="prototype-header">
    <div class="prototype-header-inner">
      <a class="prototype-wordmark" href="/" aria-label="현재 somani 블로그 홈">
        <span aria-hidden="true">s.</span>
        <strong>somani</strong>
        <i>/lab</i>
      </a>
      <nav aria-label="디자인 시안 선택">
        <a href="/prototypes/editorial-workspace/"{% if 'prototype-a' in prototypeClass %} aria-current="page"{% endif %}>A / Editorial</a>
        <a href="/prototypes/creative-desktop/"{% if 'prototype-b' in prototypeClass %} aria-current="page"{% endif %}>B / Desktop</a>
        <a href="/prototypes/integrated-archive/"{% if 'prototype-c' in prototypeClass %} aria-current="page"{% endif %}>C / Integrated</a>
      </nav>
      <div class="prototype-actions">
        <a class="current-site-link" href="/">Current site ↗</a>
        <button class="prototype-theme-toggle" type="button" aria-label="라이트 모드로 전환">
          <span class="prototype-theme-icon" aria-hidden="true">☼</span>
          <span class="prototype-theme-label" aria-hidden="true">Light</span>
        </button>
      </div>
    </div>
  </header>
  <main id="prototype-main" class="prototype-main" tabindex="-1">
    {{ content | safe }}
  </main>
  <footer class="prototype-footer">
    <p><strong>somani's archive</strong> / design study only</p>
    <div><a href="/archive/">Archive</a><a href="/about/">About</a><a href="{{ site.github }}">GitHub ↗</a></div>
  </footer>
</body>
</html>

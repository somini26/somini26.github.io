---
layout: base.njk
---
<div class="prototype-reading-progress" aria-hidden="true"></div>
<article class="prototype-article" data-prototype-article>
  <header class="prototype-article-header">
    <div class="article-kicker"><span>ARCHIVE / NOTE 001</span><span>{{ date | dateISO }}</span></div>
    <a class="prototype-back-link" href="/archive/">← 전체 기록</a>
    <h1>{{ title }}</h1>
    <p class="prototype-article-deck">{{ description }}</p>
    <div class="prototype-article-meta"><span>{{ date | dateISO }}</span><span>{{ content | readingTime }} min read</span>{% for category in categories %}<a href="/categories/{{ category | categorySlug }}/">{{ category }}</a>{% endfor %}</div>
    <div class="prototype-article-tags">{% for tag in tags %}<a href="/archive/?tag={{ tag | urlencode }}">#{{ tag }}</a>{% endfor %}</div>
  </header>
  <div class="prototype-reading-grid">
    <div class="prototype-prose" id="post-content" data-prototype-prose>{{ content | safe }}</div>
    <aside class="prototype-article-rail" aria-label="게시글 보조 정보">
      <div class="desktop-window prototype-toc-window"><div class="window-titlebar"><span class="window-index">INDEX</span><span>ON THIS PAGE</span></div><nav data-prototype-toc aria-label="게시글 목차"></nav></div>
      <a class="prototype-rail-link" href="/archive/">전체 기록으로 돌아가기 ↗</a>
    </aside>
  </div>
</article>

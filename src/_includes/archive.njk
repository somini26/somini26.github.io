<section class="archive-hero scene-window" data-reveal>
  <div>
    <p class="panel-kicker">{% if activeCategory %}SECTOR RECORDS{% else %}ARCHIVE BAY{% endif %}</p>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
  </div>
  <aside aria-label="보관소 정보"><span>{% if activeCategory %}Active sector{% else %}Preserved records{% endif %}</span><strong>{% if activeCategory %}{{ activeCategory }}{% else %}{{ collections.posts | length }} public logs{% endif %}</strong><small><i aria-hidden="true"></i> Archive online</small></aside>
</section>
<div class="archive-layout" data-archive data-category="{{ activeCategory or '' }}" data-reveal>
  <aside class="archive-sidebar station-panel">
    <h2 class="micro-label">SECTORS</h2>
    <a class="filter-category {% if not activeCategory %}selected{% endif %}" href="/archive/"><span>전체 기록</span><span>{{ collections.posts | length }}</span></a>
    {% for category in topics %}<a class="filter-category {% if activeCategory == category.name %}selected{% endif %}" href="/categories/{{ category.slug }}/"><span>{{ category.name }}</span><span>{{ collections.posts | inCategory(category.name) | length }}</span></a>{% endfor %}
    <div class="archive-shelf" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  </aside>
  <section class="archive-content station-panel" aria-label="게시글 목록">
    <div class="archive-controls">
      <form class="search-form" role="search"><label for="search" class="sr-only">게시글 검색</label><span aria-hidden="true">⌕</span><input id="search" name="q" type="search" placeholder="글 제목이나 내용을 검색해 보세요..." autocomplete="off"><button type="submit">검색</button></form>
      <button class="sort-toggle" id="sort-toggle" type="button" aria-label="현재 최신순, 오래된순으로 전환">최신순 ↓</button>
    </div>
    <div class="filter-bar">
      <label for="category-filter">카테고리</label>
      <select id="category-filter"{% if activeCategory %} data-fixed-category="{{ activeCategory }}"{% endif %}>
        <option value="">전체 카테고리</option>
        {% for category in topics %}<option value="{{ category.name }}"{% if activeCategory == category.name %} selected{% endif %}>{{ category.name }}</option>{% endfor %}
      </select>
      <label for="tag-filter">태그</label><select id="tag-filter"><option value="">전체 태그</option></select>
      <button class="reset-button" type="button" hidden>필터 초기화 ↺</button>
    </div>
    <div class="results-meta"><span id="result-count" role="status" aria-live="polite">{% if activeCategory %}{{ collections.posts | inCategory(activeCategory) | length }}{% else %}{{ collections.posts | length }}{% endif %}개의 기록</span><span>RECORDED DATA STREAM</span></div>
    <div id="archive-results" class="post-list">{% if activeCategory %}{% set visiblePosts = collections.posts | inCategory(activeCategory) %}{% else %}{% set visiblePosts = collections.posts %}{% endif %}{% for post in visiblePosts %}{% include 'post-card.njk' %}{% else %}<div class="empty-state"><span aria-hidden="true">◇</span><h2>아직 공개된 기록이 없습니다.</h2><a class="text-link" href="/archive/">전체 기록 보기 →</a></div>{% endfor %}</div>
    <noscript><p class="notice">검색과 태그 필터를 사용하려면 JavaScript를 켜 주세요.</p></noscript>
  </section>
</div>

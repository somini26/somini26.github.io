<header class="page-heading archive-heading" data-reveal>
  <p class="section-kicker">{% if activeCategory %}CATEGORY ARCHIVE{% else %}WRITING ARCHIVE{% endif %}</p>
  <h1>{{ title }}</h1>
  <p>{{ description }}</p>
</header>
<section class="archive-content surface" data-archive data-category="{{ activeCategory or '' }}" data-reveal aria-label="게시글 목록">
  <div class="archive-controls">
    <form class="search-form" role="search"><label for="search" class="sr-only">게시글 검색</label><span aria-hidden="true">⌕</span><input id="search" name="q" type="search" placeholder="글 제목이나 내용을 검색해 보세요..." autocomplete="off"><button type="submit">검색</button></form>
    <button class="sort-toggle" id="sort-toggle" type="button" aria-label="현재 최신순, 오래된순으로 전환">최신순 ↓</button>
  </div>
  <div class="filter-bar">
    <div><label for="category-filter">카테고리</label><select id="category-filter"{% if activeCategory %} data-fixed-category="{{ activeCategory }}"{% endif %}><option value="">전체 카테고리</option>{% for category in topics %}<option value="{{ category.name }}"{% if activeCategory == category.name %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div>
    <div><label for="tag-filter">태그</label><select id="tag-filter"><option value="">전체 태그</option></select></div>
    <button class="reset-button" type="button" hidden>필터 초기화 ↺</button>
  </div>
  <nav class="category-shortcuts" aria-label="카테고리 바로가기"><a href="/archive/"{% if not activeCategory %} aria-current="page"{% endif %}>전체</a>{% for category in topics %}<a href="/categories/{{ category.slug }}/"{% if activeCategory == category.name %} aria-current="page"{% endif %}>{{ category.name }}</a>{% endfor %}</nav>
  <div class="results-meta"><span id="result-count" role="status" aria-live="polite">{% if activeCategory %}{{ collections.posts | inCategory(activeCategory) | length }}{% else %}{{ collections.posts | length }}{% endif %}개의 기록</span></div>
  <div id="archive-results" class="post-list">{% if activeCategory %}{% set visiblePosts = collections.posts | inCategory(activeCategory) %}{% else %}{% set visiblePosts = collections.posts %}{% endif %}{% for post in visiblePosts %}{% include 'post-card.njk' %}{% else %}<div class="empty-state"><span aria-hidden="true">◇</span><h2>아직 공개된 기록이 없습니다.</h2><a class="text-link" href="/archive/">전체 기록 보기 →</a></div>{% endfor %}</div>
  <noscript><p class="notice">검색과 태그 필터를 사용하려면 JavaScript를 켜 주세요.</p></noscript>
</section>

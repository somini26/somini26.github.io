<article class="post-card">
  <div class="post-meta"><time datetime="{{ post.date | dateISO }}">{{ post.date | dateISO }}</time><span>·</span><span>{{ post.templateContent | readingTime }}분 읽기</span></div>
  <h3><a href="{{ post.url }}">{{ post.data.title }}<span aria-hidden="true">↗</span></a></h3>
  <p>{{ post.data.description }}</p>
  <div class="post-bottom"><div class="tags">{% for tag in post.data.tags %}<a href="/archive/?tag={{ tag | urlencode }}">#{{ tag }}</a>{% endfor %}</div><div class="category-links">{% for category in post.data.categories %}<a class="category-label" href="/categories/{{ category | categorySlug }}/">{{ category }}</a>{% endfor %}</div></div>
</article>

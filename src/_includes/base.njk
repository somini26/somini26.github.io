<!doctype html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.name }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or (site.name + ' — learn, make, archive') }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/social.png">
  {% if layout == 'post.njk' %}<meta property="article:published_time" content="{{ date | dateISO }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="/feed.xml">
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/site.css">
  <script src="/assets/app.js" defer></script>
</head>
<body class="site-page{% if page.url == '/' %} home-page{% endif %}{% if layout == 'post.njk' %} article-page{% endif %}">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="site-wordmark" href="/" aria-label="{{ site.name }} 홈"><span aria-hidden="true">s.</span><strong>somani</strong></a>
      <nav id="main-nav" class="desktop-nav" aria-label="주 메뉴">
        {% for label, href in [['Home','/'],['Archive','/archive/'],['Categories','/categories/'],['About','/about/']] %}
        <a href="{{ href }}"{% if page.url == href or (href == '/archive/' and page.url and '/posts/' in page.url) or (href == '/categories/' and page.url and '/categories/' in page.url) %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
      <div class="header-actions">
        <a class="github-link" href="{{ site.github }}" aria-label="GitHub 프로필">GitHub <span aria-hidden="true">↗</span></a>
        <button class="theme-toggle" type="button" aria-label="라이트 모드로 전환" hidden><span class="theme-icon" aria-hidden="true">☼</span><span class="theme-label" aria-hidden="true">Light</span></button>
      </div>
    </div>
  </header>
  <main id="main" class="site-main{% if page.url != '/' and layout != 'post.njk' %} content-main{% endif %}" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <div><a class="footer-brand" href="/">somani<span>.</span></a><p>새롭게 배운 내용과 직접 경험한 것을 오래 남기는 개인 아카이브</p></div>
    <nav aria-label="푸터 메뉴"><a href="/archive/">Archive</a><a href="/about/">About</a><a href="/feed.xml">RSS ↗</a><a href="{{ site.github }}">GitHub ↗</a></nav>
  </footer>
  <nav class="mobile-dock" aria-label="모바일 주 메뉴">
    {% for label, href, icon in [['Home','/','⌂'],['Archive','/archive/','◫'],['Categories','/categories/','⌗'],['About','/about/','◌']] %}
    <a href="{{ href }}"{% if page.url == href or (href == '/archive/' and page.url and '/posts/' in page.url) or (href == '/categories/' and page.url and '/categories/' in page.url) %} aria-current="page"{% endif %}><span aria-hidden="true">{{ icon }}</span><strong>{{ label }}</strong></a>
    {% endfor %}
  </nav>
</body>
</html>

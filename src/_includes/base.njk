<!doctype html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.name }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or (site.name + ' — System Hacking · Reversing · Development') }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/social.png">
  {% if layout == 'post.njk' %}<meta property="article:published_time" content="{{ date | dateISO }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="/feed.xml">
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/archive.css">
  <link rel="stylesheet" href="/assets/integrated-archive.css">
  <script src="/assets/app.js" defer></script>
</head>
<body class="prototype-page site-production{% if page.url == '/' %} integrated-archive{% endif %}{% if layout == 'post.njk' %} integrated-article{% endif %}">
  <a class="prototype-skip" href="#main">본문으로 건너뛰기</a>
  <header class="prototype-header">
    <div class="prototype-header-inner">
      <a class="prototype-wordmark" href="/" aria-label="{{ site.name }} 홈"><span aria-hidden="true">s.</span><strong>somani</strong><i>/archive</i></a>
      <button class="menu-toggle prototype-menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden>메뉴</button>
      <nav id="main-nav" aria-label="주 메뉴">
        {% for label, href in [['Home','/'],['Archive','/archive/'],['Categories','/categories/'],['About','/about/']] %}
        <a href="{{ href }}"{% if page.url == href or (href == '/archive/' and page.url and '/posts/' in page.url) or (href == '/categories/' and page.url and '/categories/' in page.url) %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
      <div class="prototype-actions">
        <a class="current-site-link prototype-github-link" href="{{ site.github }}">GitHub ↗</a>
        <button class="theme-toggle prototype-theme-toggle" type="button" aria-label="라이트 모드로 전환" hidden><span class="theme-icon prototype-theme-icon" aria-hidden="true">☼</span><span class="theme-label prototype-theme-label" aria-hidden="true">Light</span></button>
      </div>
    </div>
  </header>
  <main id="main" class="prototype-main{% if page.url != '/' and layout != 'post.njk' %} production-content{% endif %}" tabindex="-1">{{ content | safe }}</main>
  <footer class="prototype-footer">
    <p><strong>somani's archive</strong> / things I learn and build</p>
    <div><a href="/archive/">Archive</a><a href="/about/">About</a><a href="/feed.xml">RSS ↗</a><a href="{{ site.github }}">GitHub ↗</a></div>
  </footer>
</body>
</html>

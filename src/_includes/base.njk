<!doctype html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.name }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or (site.name + ' — Security · CTF · Development') }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/social.png">
  {% if layout == 'post.njk' %}<meta property="article:published_time" content="{{ date | dateISO }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="/feed.xml">
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/app.js" defer></script>
</head>
<body{% if page.url == '/' %} class="home-page"{% endif %}>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="/" aria-label="{{ site.name }} 홈"><span class="brand-mark" aria-hidden="true">s.</span>{{ site.name }}<span class="brand-dot">/</span></a>
      <button class="menu-toggle icon-button" aria-expanded="false" aria-controls="main-nav" hidden>메뉴</button>
      <nav id="main-nav" aria-label="주 메뉴">
        {% for label, href in [['Home','/'],['Archive','/archive/'],['Categories','/categories/'],['About','/about/']] %}
        <a href="{{ href }}" {% if page.url == href or (href == '/archive/' and page.url and '/posts/' in page.url) or (href == '/categories/' and page.url and '/categories/' in page.url) %}aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
      <div class="header-actions"><a class="github-link" href="{{ site.github }}" aria-label="{{ site.name }} GitHub 프로필">GitHub <span aria-hidden="true">↗</span></a><button class="theme-toggle icon-button" aria-label="라이트 모드로 전환" hidden><span aria-hidden="true">☼</span></button></div>
    </div>
  </header>
  <main id="main" class="container" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer container"><div><a class="footer-brand" href="/">{{ site.name }}<span>.</span></a><p>Security · CTF · Development</p></div><div class="footer-links"><a href="{{ site.github }}">GitHub ↗</a><a href="/feed.xml">RSS ↗</a><a href="/archive/">Archive</a><span>© {{ '2026' }} {{ site.name }}</span></div></footer>
</body>
</html>

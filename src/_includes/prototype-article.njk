<div class="prototype-reading-progress" aria-hidden="true"></div>
<article class="prototype-article" data-prototype-article>
  <header class="prototype-article-header">
    <div class="article-kicker"><span>{{ articleNumber }}</span><span>BUILD LOG / 2026</span></div>
    <a class="prototype-back-link" href="{{ prototypeHome }}">← {{ backLabel }}</a>
    <h1>{{ post.data.title }}</h1>
    <p class="prototype-article-deck">{{ post.data.description }}</p>
    <div class="prototype-article-meta">
      <span>{{ post.date | dateISO }}</span>
      <span>{{ post.templateContent | readingTime }} min read</span>
      {% for category in post.data.categories %}<a href="/categories/{{ category | categorySlug }}/">{{ category }}</a>{% endfor %}
    </div>
    <div class="prototype-article-tags">{% for tag in post.data.tags %}<a href="/archive/?tag={{ tag | urlencode }}">#{{ tag }}</a>{% endfor %}</div>
  </header>

  <div class="prototype-reading-grid">
    <div class="prototype-prose" data-prototype-prose>{{ post.templateContent | safe }}</div>
    <aside class="prototype-article-rail" aria-label="게시글 보조 정보">
      <div class="desktop-window prototype-toc-window">
        <div class="window-titlebar"><span class="window-index">INDEX</span><span>ON THIS PAGE</span></div>
        <nav data-prototype-toc aria-label="프로토타입 게시글 목차"></nav>
      </div>
      <a class="prototype-rail-link" href="/posts/github-pages-blog/">현재 사이트의 글 보기 ↗</a>
    </aside>
  </div>
</article>

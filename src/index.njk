---
layout: base.njk
---
<div class="atlas-home">
  <section class="atlas-stage" aria-labelledby="home-title" data-atlas-map>
    <div class="atlas-greeting">
      <h1 id="home-title">안녕하세요, <strong>somani</strong>입니다.</h1>
      <p>CTF · Security · Development</p>
    </div>
    <div class="atlas-map" aria-label="여섯 카테고리 궤도 지도">
      <svg class="atlas-orbits" viewBox="0 0 1400 650" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="orbitGlow" x1="0" x2="1"><stop stop-color="#8f5bdd" stop-opacity=".15"/><stop offset=".48" stop-color="#d7b4ff" stop-opacity=".9"/><stop offset="1" stop-color="#8f5bdd" stop-opacity=".18"/></linearGradient></defs>
        <ellipse cx="700" cy="330" rx="622" ry="273"/><ellipse cx="700" cy="330" rx="495" ry="213"/><ellipse cx="700" cy="330" rx="350" ry="146" stroke-dasharray="3 7"/>
        <path class="orbit-route" data-orbit="development" d="M700 330C555 252 469 205 338 174"/>
        <path class="orbit-route" data-orbit="ctf-wargame" d="M700 330C821 223 924 167 1056 151"/>
        <path class="orbit-route" data-orbit="bug-bounty" d="M700 330C927 261 1116 266 1272 319"/>
        <path class="orbit-route" data-orbit="blog-docs" d="M700 330C865 406 974 470 1097 520"/>
        <path class="orbit-route" data-orbit="papers-conferences" d="M700 330C548 423 451 480 321 519"/>
        <path class="orbit-route" data-orbit="competitions-certifications" d="M700 330C479 335 296 336 159 319"/>
        <g class="orbit-nodes"><circle cx="338" cy="174" r="5"/><circle cx="1056" cy="151" r="5"/><circle cx="1272" cy="319" r="5"/><circle cx="1097" cy="520" r="5"/><circle cx="321" cy="519" r="5"/><circle cx="159" cy="319" r="5"/></g>
      </svg>
      <div class="atlas-core" aria-hidden="true"><span class="crystal-reaction"></span><img src="/assets/images/atlas/atlas-crystal-v20261125.webp" alt="" width="720" height="720" fetchpriority="high"></div>
      {% for category in topics %}{% set categoryPosts = collections.posts | inCategory(category.name) %}{% set eagerAtlasObject = true %}
      <a class="atlas-destination route-{{ category.slug }}" href="/categories/{{ category.slug }}/" data-category-trigger data-route="{{ category.slug }}">
        <span class="destination-object">{% include 'atlas-object.njk' %}</span>
        <span class="destination-label"><strong>{{ category.name }}</strong><small>{{ categoryPosts | length }}개의 기록</small>{% if category.slug == 'ctf-wargame' %}<em>기록 보기 →</em>{% endif %}</span>
      </a>
      {% endfor %}
      <img class="atlas-ship" src="/assets/images/atlas/atlas-ship-v20261125.webp" alt="" width="640" height="640" fetchpriority="high">
    </div>
  </section>

  <nav class="atlas-mobile-routes" aria-label="카테고리 목적지">
    {% for category in topics %}{% set categoryPosts = collections.posts | inCategory(category.name) %}{% set eagerAtlasObject = false %}
    <a href="/categories/{{ category.slug }}/" data-category-trigger data-route="{{ category.slug }}"><span class="mobile-route-object">{% include 'atlas-object.njk' %}</span><strong>{{ category.name }}</strong><span>{{ categoryPosts | length }}</span><i aria-hidden="true">→</i></a>
    {% endfor %}
  </nav>

  <section class="atlas-recent" aria-labelledby="recent-title">
    <header><h2 id="recent-title">최근 기록</h2><a href="/archive/">전체 기록 →</a></header>
    <div class="atlas-recent-grid">
      {% for post in collections.posts | take(3) %}
      <a class="recent-record" href="{{ post.url }}">
        <span class="recent-record-category">{{ post.data.categories | join(' · ') }}</span>
        <strong>{{ post.data.title }}</strong>
        {% if post.data.description %}<span class="recent-record-description">{{ post.data.description }}</span>{% endif %}
        <span class="recent-record-footer"><time datetime="{{ post.date | dateISO }}">{{ post.date | dateISO }}</time><i aria-hidden="true">→</i></span>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="home-profile-continuation" aria-label="somani 프로필">
    <a class="home-profile-portrait" href="/about/"><img src="{{ profile.image }}" alt="{{ profile.imageAlt }}" width="736" height="781" loading="lazy"></a>
    <div><p class="eyebrow">PROFILE</p><h2>{{ profile.name }} / {{ profile.nickname }}</h2><p>{{ profile.affiliation }}</p><a href="mailto:{{ profile.email }}">{{ profile.email }}</a></div>
    <nav aria-label="프로필 링크"><a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="{{ profile.tistory }}" target="_blank" rel="noopener noreferrer">Tistory ↗</a><a href="/about/">About →</a></nav>
  </section>

  {% for project in projects %}<aside class="home-project"><span>Current project</span><strong>{{ project.name }}</strong><p>{{ project.description }}</p><a href="{{ project.post }}">구축 기록 보기 →</a></aside>{% endfor %}
</div>

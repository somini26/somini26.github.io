---
layout: base.njk
---
<div class="home-shell">
  <section class="home-hero" aria-labelledby="home-title" data-reveal>
    <div class="hero-copy">
      <h1 id="home-title">안녕하세요,<br><strong>somani</strong>입니다.</h1>
      <p class="hero-description">다양한 분야에 호기심을 가지고 공부하며, 새롭게 배운 내용과 직접 경험한 것들을 기록하는 공간입니다.</p>
      <ul class="interest-keywords" aria-label="관심 분야"><li>CTF</li><li>Security</li><li>AI</li><li>Development</li></ul>
      <nav class="hero-actions" aria-label="빠른 탐색"><a href="#archive-map">카테고리 둘러보기 <span aria-hidden="true">↓</span></a><a href="/archive/">모든 기록 보기 <span aria-hidden="true">↗</span></a></nav>
    </div>

    {% for post in collections.posts | take(1) %}
    <a class="cluster-note latest-note" href="{{ post.url }}"><span>최근 기록</span><time datetime="{{ post.date | dateISO }}">{{ post.date | dateISO }}</time><strong>{{ post.data.title }}</strong><p>{{ post.data.description }}</p><i aria-hidden="true">↗</i></a>
    {% endfor %}

    <a class="profile-orbit" href="/about/">
      <span class="profile-space-orbits" aria-hidden="true"></span>
      <span class="orbit-star orbit-star-one" aria-hidden="true">✦</span><span class="orbit-star orbit-star-two" aria-hidden="true">✦</span><span class="orbit-star orbit-star-three" aria-hidden="true">✦</span>
      <span class="portrait-frame"><img src="{{ profile.image }}" alt="{{ profile.imageAlt }}" width="736" height="781"><i aria-hidden="true"></i></span>
      <span class="profile-orbit-copy"><small>{{ profile.name }} · 울산대학교</small><strong>somani의 프로필</strong><span>프로필 보기 ↗</span></span>
    </a>

    {% if collections.posts[1] %}{% set otherPost = collections.posts[1] %}
    <a class="cluster-note project-note" href="{{ otherPost.url }}"><span>다른 최근 기록</span><time datetime="{{ otherPost.date | dateISO }}">{{ otherPost.date | dateISO }}</time><strong>{{ otherPost.data.title }}</strong><p>{{ otherPost.data.description }}</p><i aria-hidden="true">↗</i></a>
    {% else %}
    <a class="cluster-note project-note" href="/archive/"><span>다른 최근 기록</span><strong>전체 기록</strong><p>공개된 글을 모두 확인할 수 있습니다.</p><i aria-hidden="true">↗</i></a>
    {% endif %}

    <svg class="cluster-links" data-cluster-links viewBox="0 0 1000 570" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <g class="cluster-path path-one" data-link-group="project"><path data-link-path="project" d="M690 145 C735 145 748 112 790 112"></path><circle data-link-start="project" cx="690" cy="145" r="4"></circle><circle data-link-end="project" cx="790" cy="112" r="4"></circle></g>
      <g class="cluster-path path-two" data-link-group="latest"><path data-link-path="latest" d="M300 440 C430 440 495 395 550 285"></path><circle data-link-start="latest" cx="300" cy="440" r="4"></circle><circle data-link-end="latest" cx="550" cy="285" r="4"></circle></g>
    </svg>
  </section>

  <section class="archive-switchboard" id="archive-map" aria-label="카테고리 탐색" data-archive-switchboard data-reveal>
    <div class="switchboard-grid">
      <ol class="category-switches">
        {% for category in topics %}{% set categoryPosts = collections.posts | inCategory(category.name) %}
        <li{% if loop.first %} class="is-active"{% endif %}>
          <a href="/categories/{{ category.slug }}/" data-category-trigger data-preview-id="category-preview-{{ loop.index }}" data-index="{{ loop.index0 }}"{% if loop.first %} data-active="true"{% endif %}>
            <span class="switch-number">0{{ loop.index }}</span>
            <span class="switch-title"><strong>{{ category.name }}</strong><small>{{ category.description }}</small></span>
            <span class="switch-count">{{ categoryPosts | length }}<small>개의 기록</small></span>
            <span class="switch-arrow" aria-hidden="true">↗</span>
            <span class="switch-mobile-note">{% for post in categoryPosts | take(1) %}최근 · {{ post.data.title }}{% else %}아직 공개된 기록이 없습니다.{% endfor %}</span>
          </a>
        </li>
        {% endfor %}
      </ol>
      <div class="signal-lane" aria-hidden="true"><span class="signal-node"></span><i></i></div>
      <div class="category-stage" aria-live="polite">
        <div class="stage-status"><span>선택한 분야</span><strong data-selected-topic>{{ topics[0].name }}</strong></div>
        {% for category in topics %}{% set categoryPosts = collections.posts | inCategory(category.name) %}
        <section id="category-preview-{{ loop.index }}" data-category-panel{% if not loop.first %} hidden{% endif %}>
          <span class="stage-number" aria-hidden="true">0{{ loop.index }}</span>
          <p>{{ category.description }}</p>
          <div class="stage-record">
            {% for post in categoryPosts | take(1) %}<span>최근 기록 · {{ post.date | dateISO }}</span><a href="{{ post.url }}">{{ post.data.title }} <i aria-hidden="true">↗</i></a>{% else %}<span>아직 공개된 기록이 없습니다.</span>{% endfor %}
          </div>
          <a class="stage-open" href="/categories/{{ category.slug }}/">{{ category.name }} 전체 보기 <span aria-hidden="true">→</span></a>
        </section>
        {% endfor %}
      </div>
    </div>
  </section>
</div>
